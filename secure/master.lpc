inherit "/secure/master/error.lpc";
inherit "/secure/master/connect.lpc";

private nomask void preload(string file) {
  object o;

  write("Preloading: " + file + "...  ");
  catch(o = load_object(file));
}

string *epilog(int eflag) {
  return ({ "/secure/imud/imud.lpc" });
}

string get_root_uid() {
  return "ROOT";
}

string get_bb_uid() {
  return "BACKBONE";
}

// The driver's mudlib_stats package asks for the author of the master file
// and the domain of "/" once at boot, and prints a warning on every boot when
// these two applies are missing. Root as every file's author and the backbone
// uid as its domain (the driver then gives each object its creator's domain)
// are the values it used without them.
string author_file(string file) {
  return get_root_uid();
}

string domain_file(string file) {
  return get_bb_uid();
}

string creator_file() {
  return "";
}

int valid_socket() {
  return 1;
}

int valid_read() {
  return 1;
}

int valid_write() {
  return 1;
}
